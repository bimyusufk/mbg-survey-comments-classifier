# Salin menjadi .env (jangan di-commit). Host server (yang menjalankan
# scripts/serve.py) tidak perlu mengisi apa pun: .env dibuat otomatis.
#
# Anggota tim yang menjalankan training di laptop sendiri dan ingin hasilnya
# masuk ke dashboard MLflow bersama, isi tiga baris ini dengan data yang
# dibagikan host lewat grup privat:
MLFLOW_TRACKING_URI=https://xxxx.trycloudflare.com
MLFLOW_TRACKING_USERNAME=tim
MLFLOW_TRACKING_PASSWORD=
